# Copy this file to .env. Never commit .env.
# Demo mode is deterministic local planning and needs no key.
FESTIVA_AI_MODE=demo

# Server-side Gemini configuration. Leave the key blank in committed files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Bounded request settings (optional).
# On Vercel, use 15 so two transient retries fit inside the 60s function limit.
GEMINI_TIMEOUT_SECONDS=45
FESTIVA_AI_MAX_OUTPUT_TOKENS=4096
FESTIVA_AI_TEMPERATURE=0.5
FESTIVA_AI_CACHE_TTL_SECONDS=3600

# On Vercel, connect a private Blob store. The generated
# BLOB_READ_WRITE_TOKEN selects durable Blob storage automatically.
# Without it (local development/tests), SQLite uses this path.
FESTIVA_DB_PATH=festiva.db
FESTIVA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Signs anonymous, browser-bound session cookies that isolate each visitor's
# plans. Required on Vercel; use at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FESTIVA_SESSION_SECRET=
